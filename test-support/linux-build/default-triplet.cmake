set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR "${TEST_PROCESSOR}")
set(CMAKE_CURRENT_SOURCE_DIR "${TEST_SOURCE_DIR}")
include("${TEST_SOURCE_DIR}/cmake/SnowWorkspace.cmake")
if(DEFINED TEST_OVERRIDE)
    set(VCPKG_TARGET_TRIPLET "${TEST_OVERRIDE}" CACHE STRING "")
endif()
snow_workspace_configure_paths()
if(NOT VCPKG_TARGET_TRIPLET STREQUAL TEST_EXPECTED)
    message(FATAL_ERROR "Expected ${TEST_EXPECTED}, got ${VCPKG_TARGET_TRIPLET}")
endif()
